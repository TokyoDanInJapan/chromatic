{
  "name": "chromatic",
  "version": "1.1.0",
  "description": "Chromatic aberration in the browser, by magnifying each colour channel by a different amount.",
  "license": "MIT",
  "author": "Daniel Hebberd",
  "keywords": [
    "chromatic-aberration",
    "lens",
    "dispersion",
    "canvas",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokyoDanInJapan/chromatic.git"
  },
  "homepage": "https://github.com/TokyoDanInJapan/chromatic#readme",
  "bugs": {
    "url": "https://github.com/TokyoDanInJapan/chromatic/issues"
  },
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./chromatic.js": "./chromatic.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "chromatic.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write .",
    "check": "npm run check:format && npm run check:types",
    "check:format": "prettier --check .",
    "check:types": "tsc --noEmit"
  },
  "devDependencies": {
    "prettier": "^3.9.0",
    "typescript": "^6.0.3"
  },
  "types": "./index.d.ts"
}
